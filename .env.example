# Скопируйте этот файл в .env и заполните (на Render эти же переменные задаются в разделе Environment).

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=

# Чаты ресторанов: заказ уходит в чат выбранной точки (P1 Патриот, P2 Орбита, P3 Среда, P4 Янтарь, P5 Китай-город).
# ID чата бот пишет сам, когда его добавляют в группу (или по команде /id).
TELEGRAM_CHAT_ID_P1=
TELEGRAM_CHAT_ID_P2=
TELEGRAM_CHAT_ID_P3=
TELEGRAM_CHAT_ID_P4=
TELEGRAM_CHAT_ID_P5=

# Отдельный чат для заявок на работу (можно оставить пустым — тогда заявка уходит в чат выбранного ресторана)
TELEGRAM_CHAT_ID_JOBS=

# Запасной общий чат — сюда идут заказы точек, у которых свой чат не задан (можно оставить пустым)
TELEGRAM_CHAT_ID=

# Адрес сайта для бота (на Render не нужен — он берётся из RENDER_EXTERNAL_URL)
PUBLIC_URL=

# Порт сайта
PORT=3000
